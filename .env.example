# Copia este archivo a .env para desarrollo local. NUNCA subas .env a GitHub.
# En producción, estas variables van en Netlify (y en Railway para el worker).

# Push del navegador (npm run vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tucorreo@gmail.com

# URL pública del sitio (enlaces en correos y Telegram)
SITE_URL=https://sismos-eje-cafetero.netlify.app

# Telegram (opcional): token de @BotFather y un secreto inventado por ti
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Correo con Resend (opcional)
RESEND_API_KEY=
CORREO_REMITENTE=Alertas de sismos <alertas@tudominio.com>
CORREO_MIN_MAG=3

# ntfy: funciona sin configurar. Pon NTFY_DESACTIVADO=1 para ocultarlo.
# NTFY_SERVIDOR=https://ntfy.sh

# Solo el worker (fuera de Netlify)
NETLIFY_SITE_ID=
NETLIFY_API_TOKEN=
POLL_SECONDS=12
